{
  "name": "dsh-paper-reader-evidence",
  "version": "1.1.4",
  "description": "DeepSeek Harness 插件：论文伴读工作台 + 可点击回原文框选的证据引用 + 可展开查证过程。基于 @ggboy123/dsh-paper-reader v1.12.0（MIT）扩展。",
  "license": "MIT",
  "type": "module",
  "author": "Raymond",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raymond2967/dsh-paper-reader-evidence.git"
  },
  "bugs": {
    "url": "https://github.com/Raymond2967/dsh-paper-reader-evidence/issues"
  },
  "homepage": "https://github.com/Raymond2967/dsh-paper-reader-evidence#readme",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "reader",
    "runtime",
    "NOTICE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "pdf",
    "pdf-reader",
    "paper",
    "paper-reading",
    "research-paper",
    "evidence",
    "citation",
    "ocr",
    "reader",
    "ai-assistant",
    "rag",
    "translation"
  ],
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "pdfjs-dist": "^6.3.289",
    "undici": "^8.10.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}









